@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&display=swap');

/* =========================================================
 * SYNAPSE — Dual-theme design system (Neural + Library)
 * ========================================================= */

/* -------- Theme 1: Neural Network (default) -------- */
:root, [data-theme="neural"] {
  --font-display: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;
  --font-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
  --font-numeric: 'Space Grotesk', ui-sans-serif, system-ui, sans-serif;

  --bg-deep: oklch(0.13 0.02 235);
  --bg: oklch(0.17 0.025 235);
  --surface: oklch(0.22 0.03 232);
  --surface-2: oklch(0.27 0.035 230);
  --surface-3: oklch(0.32 0.04 228);

  --ink: oklch(0.98 0.005 220);
  --ink-dim: oklch(0.82 0.02 220);
  --ink-mute: oklch(0.62 0.03 225);

  --accent: oklch(0.82 0.16 195);
  --accent-2: oklch(0.72 0.19 205);
  --accent-ink: oklch(0.15 0.02 235);

  --cta: oklch(0.8 0.16 75);
  --cta-2: oklch(0.7 0.19 55);
  --cta-ink: oklch(0.16 0.03 40);
  --glow-cta: 0 0 24px oklch(0.8 0.16 75 / 0.55), 0 0 60px oklch(0.7 0.19 55 / 0.35);

  --warn: oklch(0.82 0.16 75);
  --danger: oklch(0.68 0.22 22);
  --win: oklch(0.85 0.18 145);

  --card: oklch(0.985 0.004 220);
  --card-ink: oklch(0.16 0.02 235);
  --card-edge: oklch(0.88 0.02 210);

  --border: oklch(0.35 0.04 225);
  --border-strong: oklch(0.5 0.06 220);

  --glow-accent: 0 0 24px oklch(0.82 0.16 195 / 0.55), 0 0 60px oklch(0.72 0.19 205 / 0.35);
  --glow-card: 0 0 0 1px oklch(0.82 0.16 195 / 0.35), 0 0 24px oklch(0.82 0.16 195 / 0.35);
  --shadow-lift: 0 8px 24px oklch(0 0 0 / 0.45), 0 2px 6px oklch(0 0 0 / 0.35);
  --shadow-card: 0 6px 14px oklch(0 0 0 / 0.45), 0 1px 2px oklch(0 0 0 / 0.35);

  --table-felt: radial-gradient(ellipse 70% 60% at 50% 45%, oklch(0.28 0.05 220) 0%, oklch(0.19 0.035 232) 55%, oklch(0.14 0.025 235) 100%);
  --scene-bg: radial-gradient(ellipse 90% 60% at 50% 0%, oklch(0.24 0.06 220) 0%, oklch(0.14 0.025 235) 60%, oklch(0.1 0.02 240) 100%);
  --grid-lines: linear-gradient(oklch(0.82 0.16 195 / 0.06) 1px, transparent 1px) 0 0 / 32px 32px, linear-gradient(90deg, oklch(0.82 0.16 195 / 0.06) 1px, transparent 1px) 0 0 / 32px 32px;
}

